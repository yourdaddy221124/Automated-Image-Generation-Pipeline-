# Server Configuration
PORT=3000

# Telegram Bot Integration (Optional - System defaults to simulated sandbox if omitted)
# Create bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=

# Email SMTP Integration (Optional - System defaults to simulated sandbox if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL="AI Image Pipeline <noreply@ai-pipeline.com>"

# Optional LLM API Key for Prompt Refinement (Gemini / OpenAI)
# If omitted, built-in intelligent rule engine performs prompt expansion
GEMINI_API_KEY=
